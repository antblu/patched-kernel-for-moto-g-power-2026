+namespace {
+
+constexpr std::string_view kSchedulingDirectory = "vegas26-sched";
+
+int Vegas26CpuWeight(std::string_view name) {
+    if (name == "foreground") return 400;
+    if (name == "top-app") return 500;
+    for (const std::string_view group : {"default", "background", "camera-daemon", "dex2oat",
+                                        "foreground_window", "nnapi-hal", "rt", "system",
+                                        "system-background"}) {
+        if (name == group) return 100;
+    }
+    return 0;
+}
+
+const char* Vegas26AffinityMask(std::string_view name) {
+    if (name == "default") return "";
+    if (name == "background" || name == "system-background" || name == "restricted") return "0-3";
+    if (name == "boost-app") return "1-7";
+    if (name == "foreground" || name == "h-background") return "0-6";
+    if (name == "foreground_window" || name == "top-app" || name == "camera-daemon" ||
+        name == "h-foreground") {
+        return "0-7";
+    }
+    return nullptr;
+}
+
+struct Vegas26Placement {
+    std::string scheduler;
+    std::string cpu = "default";
+    std::string affinity = "default";
+};
+
+bool ReadVegas26Placement(const CgroupControllerWrapper& controller, pid_t tid,
+                          Vegas26Placement* placement) {
+    std::string group;
+    if (!controller.GetTaskGroup(tid, &group) || group.empty()) return false;
+
+    const std::string marker = "/" + std::string(kSchedulingDirectory);
+    const size_t scheduler = group.find(marker);
+    if (scheduler == std::string::npos) {
+        placement->scheduler = std::string(controller.path()) + "/" + group + marker;
+        return true;
+    }
+
+    const size_t end = scheduler + marker.size();
+    placement->scheduler = std::string(controller.path()) + "/" + group.substr(0, end);
+    if (end == group.size()) return true;
+    if (group[end] != '/') return false;
+
+    const size_t affinity = group.find('/', end + 1);
+    placement->cpu = group.substr(end + 1, affinity == std::string::npos ? affinity
+                                                                         : affinity - end - 1);
+    if (affinity != std::string::npos) placement->affinity = group.substr(affinity + 1);
+    return Vegas26CpuWeight(placement->cpu) != 0 && Vegas26AffinityMask(placement->affinity);
+}
+
+bool OwnVegas26SchedulingGroup(const std::string& group, const struct stat& owner) {
+    for (const char* file : {"", "/cgroup.threads", "/cgroup.subtree_control"}) {
+        const auto path = group + file;
+        if (geteuid() == 0 && chown(path.c_str(), owner.st_uid, owner.st_gid) < 0) return false;
+    }
+    return true;
+}
+
+bool ApplyVegas26Scheduling(const CgroupControllerWrapper& controller, pid_t tid,
+                            const std::string& category) {
+    const bool cpu = std::string_view(controller.name()) == "cpu";
+    const std::string name = category.empty() ? "default" : category;
+    if (cpu ? Vegas26CpuWeight(name) == 0 : Vegas26AffinityMask(name) == nullptr) {
+        errno = EINVAL;
+        return false;
+    }
+
+    Vegas26Placement original;
+    if (!ReadVegas26Placement(controller, tid, &original)) return false;
+    unique_fd lock(TEMP_FAILURE_RETRY(open(original.scheduler.c_str(), O_RDONLY | O_DIRECTORY |
+                                                                         O_CLOEXEC | O_NOFOLLOW)));
+    if (lock < 0 || TEMP_FAILURE_RETRY(flock(lock.get(), LOCK_EX)) < 0) return false;
+    struct stat owner;
+    if (fstat(lock.get(), &owner) < 0) return false;
+
+    Vegas26Placement placement;
+    if (!ReadVegas26Placement(controller, tid, &placement) ||
+        original.scheduler != placement.scheduler) {
+        return false;
+    }
+    (cpu ? placement.cpu : placement.affinity) = name;
+
+    const auto cpu_group = placement.scheduler + "/" + placement.cpu;
+    if (mkdir(cpu_group.c_str(), 0750) == 0) {
+        if (!WriteStringToFile("threaded", cpu_group + "/cgroup.type") ||
+            !WriteStringToFile(std::to_string(Vegas26CpuWeight(placement.cpu)),
+                               cpu_group + "/cpu.weight") ||
+            !WriteStringToFile("+cpuset", cpu_group + "/cgroup.subtree_control") ||
+            (placement.cpu == "nnapi-hal" &&
+             (!WriteStringToFile("1.00", cpu_group + "/cpu.uclamp.min") ||
+              !WriteStringToFile("1", cpu_group + "/cpu.uclamp.latency_sensitive"))) ||
+            !OwnVegas26SchedulingGroup(cpu_group, owner)) {
+            const int error = errno;
+            rmdir(cpu_group.c_str());
+            errno = error;
+            return false;
+        }
+    } else if (errno != EEXIST) {
+        return false;
+    }
+
+    const auto affinity_group = cpu_group + "/" + placement.affinity;
+    if (mkdir(affinity_group.c_str(), 0750) == 0) {
+        std::string mask(Vegas26AffinityMask(placement.affinity));
+        std::string live_mask;
+        if (placement.affinity == "top-app" &&
+            android::base::ReadFileToString("/dev/cpuset/top-app/cpus", &live_mask)) {
+            live_mask = android::base::Trim(live_mask);
+            if (!live_mask.empty() &&
+                std::all_of(live_mask.begin(), live_mask.end(), [](char c) {
+                    return (c >= '0' && c <= '7') || c == '-' || c == ',';
+                })) {
+                mask = live_mask;
+            }
+        }
+        if (!WriteStringToFile("threaded", affinity_group + "/cgroup.type") ||
+            (!mask.empty() && !WriteStringToFile(mask, affinity_group + "/cpuset.cpus")) ||
+            !OwnVegas26SchedulingGroup(affinity_group, owner)) {
+            const int error = errno;
+            rmdir(affinity_group.c_str());
+            errno = error;
+            return false;
+        }
+    } else if (errno != EEXIST) {
+        return false;
+    }
+
+    return WriteStringToFile(std::to_string(tid), affinity_group + "/cgroup.threads") ||
+           errno == ESRCH;
+}
