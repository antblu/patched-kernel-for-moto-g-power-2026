+// Only remove descendants under the scheduler-owned directory. Other children
+// must keep the stock behaviour of preventing the process group from being removed.
+static int RemoveSchedulingSubtree(const std::string& path) {
+    const auto close_directory = [](DIR* directory) { closedir(directory); };
+    std::unique_ptr<DIR, decltype(close_directory)> children(opendir(path.c_str()), close_directory);
+    if (!children) {
+        return errno == ENOENT ? 0 : -1;
+    }
+
+    while (true) {
+        errno = 0;
+        const dirent* child = readdir(children.get());
+        if (!child) {
+            if (errno != 0) {
+                return -1;
+            }
+            break;
+        }
+        const std::string_view name(child->d_name);
+        if (child->d_type != DT_DIR || name == "." || name == "..") {
+            continue;
+        }
+        if (RemoveSchedulingSubtree(path + "/" + child->d_name) < 0) {
+            return -1;
+        }
+    }
+    if (TEMP_FAILURE_RETRY(rmdir(path.c_str())) < 0 && errno != ENOENT) {
+        return -1;
+    }
+    return 0;
+}
+
+static int RemoveProcessGroupDirectory(const std::string& path, bool v2_path) {
+    const auto scheduling_path = path + "/vegas26-sched";
+    if (v2_path && access(scheduling_path.c_str(), F_OK) == 0) {
+        std::string events;
+        if (!android::base::ReadFileToString(path + "/" + PROCESSGROUP_CGROUP_EVENTS_FILE,
+                                            &events)) {
+            return -1;
+        }
+        if (!events.starts_with("populated 0\n") &&
+            events.find("\npopulated 0\n") == std::string::npos) {
+            errno = EBUSY;
+            return -1;
+        }
+        if (RemoveSchedulingSubtree(scheduling_path) < 0) {
+            return -1;
+        }
+    }
+    return TEMP_FAILURE_RETRY(rmdir(path.c_str()));
+}
